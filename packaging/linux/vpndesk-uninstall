#!/bin/bash
# vpndesk-uninstall: the administrator part of "Uninstall VPN Desk" (Linux).
#
# Run by the app through pkexec (policy action io.vpndesk.uninstall, installed root-owned in /opt/vpn_desk).
# It takes no arguments and no paths from the caller: everything it touches is hard-coded below.
# It prints progress lines for the app's uninstall page:
#   STEP:<id>:<text>   a step has started       (firewall | package | system)
#   DONE               everything was removed
#   ERROR:<text>       something failed (nothing further is attempted)
#
# What it removes: VPN Desk's firewall table and tor, the installed package (dpkg or rpm; otherwise exactly the
# files listed below), /var/lib/vpn_desk, /run/vpn_desk and the 'vpndesk' system user. It never touches any other
# tor, firewall table or user.
set -u

PKG=vpn-desk
APPDIR=/opt/vpn_desk
DATA=/var/lib/vpn_desk
RUN=/run/vpn_desk
U=vpndesk
TABLE="inet vpndesk"
# Files a package would own, used only when VPN Desk was not installed by dpkg/rpm.
LOOSE_FILES="/usr/bin/vpndesk-restore
/usr/share/applications/io.vpndesk.VPNDesk.desktop
/usr/share/metainfo/io.vpndesk.VPNDesk.metainfo.xml
/usr/share/polkit-1/actions/io.vpndesk.net.policy"

step() { echo "STEP:$1:$2"; }
fail() { printf 'ERROR:%s\n' "$(printf '%s' "$1" | tr '\n' ' ' | cut -c1-300)"; exit 1; }

[ "$(id -u)" = 0 ] || fail "the uninstaller must run as administrator"

# 1) Firewall rules and the tor that belongs to system-wide mode.
step firewall "Removing firewall rules"
pkill -u "$U" -x tor 2>/dev/null
command -v nft >/dev/null 2>&1 && nft delete table $TABLE 2>/dev/null
rm -f "$RUN/state"

# 2) The application itself, through the package manager that installed it.
step package "Removing application files"
if command -v dpkg >/dev/null 2>&1 && dpkg -s "$PKG" >/dev/null 2>&1; then
  out="$(DEBIAN_FRONTEND=noninteractive dpkg --purge "$PKG" 2>&1)" || fail "dpkg could not remove $PKG: $out"
elif command -v rpm >/dev/null 2>&1 && rpm -q "$PKG" >/dev/null 2>&1; then
  out="$(rpm -e "$PKG" 2>&1)" || fail "rpm could not remove $PKG: $out"
else
  # Not installed by a package manager: remove exactly the known locations.
  rm -rf "$APPDIR"
  printf '%s\n' "$LOOSE_FILES" | while IFS= read -r f; do [ -n "$f" ] && rm -f "$f"; done
  for sz in 512x512 256x256 128x128 64x64; do rm -f "/usr/share/icons/hicolor/$sz/apps/vpn_desk.png"; done
fi
rmdir "$APPDIR" 2>/dev/null

# 3) System-wide mode's data and its dedicated user.
step system "Removing system helper and data"
rm -rf "$DATA" "$RUN"
if id "$U" >/dev/null 2>&1; then
  userdel "$U" 2>/dev/null || fail "could not remove the '$U' user"
fi
if getent group "$U" >/dev/null 2>&1; then groupdel "$U" 2>/dev/null; fi

# Menus and icon caches (best effort).
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database /usr/share/applications 2>/dev/null
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null

echo DONE
exit 0
